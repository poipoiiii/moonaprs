import {
  "poipoiiii/moonaprs/lib/ax25",
  "poipoiiii/moonaprs/lib/aprs",
  "poipoiiii/moonaprs/lib/track",
  "poipoiiii/moonaprs/lib/svg",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
}

pkgtype(kind: "executable")

options(
  "native-stub": [ "tcp_native.c" ],
  targets: {
    "tcp_native.mbt": [ "native", "llvm" ],
    "is_live_native.mbt": [ "native", "llvm" ],
    "is_live_other.mbt": [ "wasm", "wasm-gc", "js" ],
  },
)
