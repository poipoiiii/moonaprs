name = "poipoiiii/moonaprs"

version = "0.5.0"

description = "APRS / AX.25 amateur radio data stack for MoonBit: AX.25 UI frames, KISS, TNC2, APRS-IS passcode, packet parsing and SVG maps"

preferred_target = "native"

readme = "README.md"

repository = "https://github.com/poipoiiii/moonaprs"

license = "MIT"

keywords = [ "aprs", "ax25", "amateur-radio", "packet-radio", "kiss" ]

import {
  "moonbitlang/x@0.5.7",
}
